# Copy this file to .env (in hw4/ or its parent folder) and fill in a real key.
# Never commit the real .env. It is listed in .gitignore.

# Portkey gateway key, used for every model call
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown)
MODEL_NAME=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: set to true when the site is served over HTTPS (adds the Secure cookie flag)
COOKIE_SECURE=false
